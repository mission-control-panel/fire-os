rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Canonical document: users/{uid}/portfolio/state.
    // Authenticated owners may read and write only their own portfolio.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isIso(value) {
      return value is string && value.matches('^\\d{4}-\\d{2}-\\d{2}T.{0,28}Z$');
    }

    function isBoundedString(value, maxSize) {
      return value is string && value.size() <= maxSize;
    }

    function isBoundedMap(value, maxEntries) {
      return value is map && value.size() <= maxEntries;
    }

    function isBoundedList(value, maxEntries) {
      return value is list && value.size() <= maxEntries;
    }

    function validProfile(value) {
      return value.keys().hasOnly(['name', 'dateOfBirth', 'age', 'taxSlabRate', 'annualExpenses', 'fiTarget', 'monthlyIncome'])
        && value.name is string && value.name.size() <= 200
        && value.age >= 0 && value.age <= 150
        && value.annualExpenses >= 0 && value.annualExpenses <= 1000000000000
        && value.fiTarget >= 0 && value.fiTarget <= 1000000000000000
        && value.monthlyIncome >= 0 && value.monthlyIncome <= 1000000000000
        && (!('dateOfBirth' in value) || (value.dateOfBirth is string && value.dateOfBirth.size() <= 10))
        && (!('taxSlabRate' in value) || (value.taxSlabRate is number && value.taxSlabRate >= 0 && value.taxSlabRate <= 100));
    }

    function validNiftyData(value) {
      return value is map
        && value.keys().hasOnly(['level', 'high52w', 'timestamp', 'source', 'status'])
        && value.level is number
        && value.high52w is number
        && isIso(value.timestamp)
        && isBoundedString(value.source, 100)
        && (!('status' in value) || value.status in ['live', 'cache-fresh', 'manual']);
    }

    function validEurInrData(value) {
      return value is map
        && value.keys().hasOnly(['rate', 'timestamp'])
        && value.rate is number
        && isIso(value.timestamp);
    }

function validWatchdogRules(value) {
  return value is map
    && value.keys().hasOnly(['id', 'label', 'aumLimit', 'currentAum', 'blockThresholdDays', 'blockedDays', 'managerExits'])
    && value.keys().hasAll(['id', 'label'])
    && value.size() <= 50
    && value.id is string
    && value.label is string
    && (!('aumLimit' in value) || value.aumLimit is number)
    && (!('currentAum' in value) || value.currentAum is number)
    && (!('blockThresholdDays' in value) || value.blockThresholdDays is number)
    && (!('blockedDays' in value) || value.blockedDays is number)
    && (!('managerExits' in value) || value.managerExits is bool);
}

    function validSwpSchedule(value) {
      return value is map
        && value.keys().hasOnly(['enabled', 'startDate', 'monthlyAmount', 'rate'])
        && value.enabled is bool
        && isBoundedString(value.startDate, 20)
        && value.monthlyAmount is number
        && value.rate is number;
    }

    function validTaxCalendar(value) {
      return value is map
        && value.keys().hasOnly(['lastLTCGHarvestDate', 'lastHarvestedAmount', 'harvestTarget'])
        && isBoundedString(value.lastLTCGHarvestDate, 40)
        && value.lastHarvestedAmount is number
        && value.harvestTarget is number;
    }

    function validInsurance(value) {
      return value is map
        && value.keys().hasOnly(['termLife', 'health', 'vehicle'])
        && value.termLife is map
        && value.termLife.keys().hasOnly(['currentCover', 'annualPremium', 'expiryDate', 'provider'])
        && value.termLife.currentCover is number
        && value.termLife.annualPremium is number
        && isBoundedString(value.termLife.expiryDate, 40)
        && isBoundedString(value.termLife.provider, 200)
        && value.health is map
        && value.health.keys().hasOnly(['currentCover', 'annualPremium', 'familySize', 'provider'])
        && value.health.currentCover is number
        && value.health.annualPremium is number
        && value.health.familySize is number
        && isBoundedString(value.health.provider, 200)
        && value.vehicle is map
        && value.vehicle.keys().hasOnly(['covered', 'annualPremium'])
        && value.vehicle.covered is bool
        && value.vehicle.annualPremium is number;
    }

    function validEsopDetails(value) {
      return value is map
        && value.keys().hasOnly(['shares', 'holdings', 'grantPrice', 'liquidationShares', 'vestingFmv', 'currentPrice', 'slabRate', 'vestingSchedule', 'holdingPeriodYears', 'grants'])
        && value.shares is number
        && (!('holdings' in value) || (value.holdings is list && value.holdings.size() <= 20))
        && value.grantPrice is number
        && (!('liquidationShares' in value) || value.liquidationShares is number)
        && (!('vestingFmv' in value) || value.vestingFmv is number)
        && (!('currentPrice' in value) || value.currentPrice is number)
        && (!('slabRate' in value) || value.slabRate is number)
        && (!('holdingPeriodYears' in value) || value.holdingPeriodYears is number)
        && isBoundedList(value.vestingSchedule, 200)
        && (!('grants' in value) || validEquityGrantList(value.grants));
    }

    function validEquityGrantList(value) {
      // Firestore Rules cannot iterate list members. The bounded slots keep
      // this explicit validation within the evaluator expression budget.
      return isBoundedList(value, 1)
        && (value.size() <= 0 || validEquityGrant(value[0]));
    }

    function validEquityGrant(value) {
      return value is map
        && value.keys().hasOnly(['id', 'kind', 'symbol', 'currency', 'grantedQuantity', 'vestedQuantity', 'exercisedQuantity', 'soldQuantity', 'strikePrice', 'fairMarketValue', 'valuationAsOf', 'fxToInr', 'fxAsOf', 'taxRate', 'grantDate', 'vestingDate'])
        && value.id is string && value.id.size() > 0 && value.id.size() <= 100
        && value.kind in ['esop', 'rsu', 'espp', 'acquired']
        && value.symbol is string && value.symbol.size() <= 30
        && value.currency is string && value.currency.size() <= 10
        && value.grantedQuantity is number && value.grantedQuantity >= 0 && value.grantedQuantity <= 1000000000000
        && value.vestedQuantity is number && value.vestedQuantity >= 0 && value.vestedQuantity <= 1000000000000
        && value.exercisedQuantity is number && value.exercisedQuantity >= 0 && value.exercisedQuantity <= 1000000000000
        && value.soldQuantity is number && value.soldQuantity >= 0 && value.soldQuantity <= 1000000000000
        && value.strikePrice is number && value.strikePrice >= 0 && value.strikePrice <= 1000000000000
        && value.fairMarketValue is number && value.fairMarketValue >= 0 && value.fairMarketValue <= 1000000000000
        && value.vestedQuantity <= value.grantedQuantity
        && value.exercisedQuantity + value.soldQuantity <= value.vestedQuantity
        && (!('valuationAsOf' in value) || (value.valuationAsOf is string && value.valuationAsOf.size() <= 20))
        && (!('fxToInr' in value) || (value.fxToInr is number && value.fxToInr > 0 && value.fxToInr <= 1000000000000))
        && (!('fxAsOf' in value) || (value.fxAsOf is string && value.fxAsOf.size() <= 20))
        && (!('taxRate' in value) || (value.taxRate is number && value.taxRate >= 0 && value.taxRate <= 1))
        && (!('grantDate' in value) || (value.grantDate is string && value.grantDate.size() <= 20))
        && (!('vestingDate' in value) || (value.vestingDate is string && value.vestingDate.size() <= 20));
    }

    function validTransactionLedger(value) {
      return value is map && value.size() <= 7;
    }

    function validMfEntry(value) {
      return value is map
        && value.keys().hasOnly(['name', 'schemeCode', 'units', 'startDate', 'monthlyAmount', 'costBasis', 'bucketId'])
        && isBoundedString(value.name, 200)
        && (!('schemeCode' in value) || isBoundedString(value.schemeCode, 50))
        && value.units is number && value.units >= 0 && value.units <= 1000000000000
        && isBoundedString(value.startDate, 20) && value.startDate.matches('^(?:\\d{4}-(?:0[1-9]|1[0-2])|\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)$')
        && value.monthlyAmount is number && value.monthlyAmount >= 0 && value.monthlyAmount <= 1000000000000
        && (!('costBasis' in value) || (value.costBasis is number && value.costBasis >= 0 && value.costBasis <= 1000000000000000))
        && (!('bucketId' in value) || isBoundedString(value.bucketId, 20));
    }

    function validMfHoldingDocument() {
      return request.resource.data.keys().hasOnly(['kind', 'value', 'updatedAt', 'revision'])
        && request.resource.data.keys().hasAll(['kind', 'value', 'updatedAt'])
        && request.resource.data.kind == 'mf'
        && validMfEntry(request.resource.data.value)
        && isIso(request.resource.data.updatedAt)
        && (!('revision' in request.resource.data)
          || (request.resource.data.revision is int
            && request.resource.data.revision >= 0
            && request.resource.data.revision <= 1000000000));
    }

    function validClient() {
      return !('client' in request.resource.data)
        || (request.resource.data.client is map
          && request.resource.data.client.keys().hasOnly(['clientId', 'appVersion', 'platform', 'userAgent', 'lastWriteId'])
          && (!('clientId' in request.resource.data.client) || isBoundedString(request.resource.data.client.clientId, 100))
          && (!('appVersion' in request.resource.data.client) || isBoundedString(request.resource.data.client.appVersion, 50))
          && (!('platform' in request.resource.data.client) || request.resource.data.client.platform in ['web', 'mobile'])
          && (!('userAgent' in request.resource.data.client) || isBoundedString(request.resource.data.client.userAgent, 512))
          && (!('lastWriteId' in request.resource.data.client) || isBoundedString(request.resource.data.client.lastWriteId, 100)));
    }

    function validSectionClocks() {
      return !('sectionUpdatedAt' in request.resource.data)
        || (request.resource.data.sectionUpdatedAt is map
          && request.resource.data.sectionUpdatedAt.keys().hasOnly(['profile', 'holdings', 'planning', 'insurance', 'esop', 'cache'])
          && (!('profile' in request.resource.data.sectionUpdatedAt) || isIso(request.resource.data.sectionUpdatedAt.profile))
          && (!('holdings' in request.resource.data.sectionUpdatedAt) || isIso(request.resource.data.sectionUpdatedAt.holdings))
          && (!('planning' in request.resource.data.sectionUpdatedAt) || isIso(request.resource.data.sectionUpdatedAt.planning))
          && (!('insurance' in request.resource.data.sectionUpdatedAt) || isIso(request.resource.data.sectionUpdatedAt.insurance))
          && (!('esop' in request.resource.data.sectionUpdatedAt) || isIso(request.resource.data.sectionUpdatedAt.esop))
          && (!('cache' in request.resource.data.sectionUpdatedAt) || isIso(request.resource.data.sectionUpdatedAt.cache)));
    }

    function validPersistedData() {
      let data = request.resource.data.data;
      return data.keys().hasOnly([
          'profile', 'sip', 'fd', 'epf', 'esop', 'bonds', 'otherHoldings', 'liabilities', 'demat',
          'nav', 'niftyHigh', 'niftyData', 'currencyRates', 'eurInr', 'eurInrData',
          'alphaTrackerData', 'goals', 'fundBuckets', 'watchdogRules', 'swpSchedule', 'taxCalendar',
          'expenses', 'transactionLedger', 'netWorthHistory', 'completedActions', 'achievedMilestones',
          'insurance', 'esopDetails', 'liquidationRules', 'assistant'
        ])
        && (!('profile' in data) || validProfile(data.profile))
        && (!('currencyRates' in data) || isBoundedMap(data.currencyRates, 200))
        && (!('liabilities' in data) || isBoundedMap(data.liabilities, 50))
        && (!('otherHoldings' in data) || isBoundedMap(data.otherHoldings, 200))
        && (!('goals' in data) || isBoundedList(data.goals, 50))
        && (!('fundBuckets' in data) || isBoundedList(data.fundBuckets, 10))
        && (!('watchdogRules' in data) || isBoundedList(data.watchdogRules, 50))
        && (!('liquidationRules' in data) || isBoundedList(data.liquidationRules, 50))
        && (!('achievedMilestones' in data) || isBoundedList(data.achievedMilestones, 500))
        && (!('insurance' in data) || data.insurance is map)
        && (!('transactionLedger' in data) || validTransactionLedger(data.transactionLedger))
        && (!('esopDetails' in data) || validEsopDetails(data.esopDetails));
    }

    function validServerMetadata() {
      return !('serverMetadata' in request.resource.data)
        || (request.resource.data.serverMetadata is map
          && request.resource.data.serverMetadata.keys().hasOnly(['savedBy', 'savedAt'])
          && (!('savedBy' in request.resource.data.serverMetadata) || isBoundedString(request.resource.data.serverMetadata.savedBy, 128))
          && (!('savedAt' in request.resource.data.serverMetadata) || isIso(request.resource.data.serverMetadata.savedAt)));
    }

    function validEntryUpdatedAt() {
      return !('entryUpdatedAt' in request.resource.data)
        || (request.resource.data.entryUpdatedAt is map
          && request.resource.data.entryUpdatedAt.keys().hasOnly(['holdings'])
          && (!('holdings' in request.resource.data.entryUpdatedAt)
            || isBoundedMap(request.resource.data.entryUpdatedAt.holdings, 200)));
    }

    function validMigration() {
      return !('migration' in request.resource.data)
        || (request.resource.data.migration is map
          && request.resource.data.migration.keys().hasOnly(['source', 'completedAt', 'sourceVersion'])
          && request.resource.data.migration.source in ['localStorage', 'json']
          && isIso(request.resource.data.migration.completedAt)
          && isBoundedString(request.resource.data.migration.sourceVersion, 50));
    }

    function validFormat() {
      return !('format' in request.resource.data)
        || (request.resource.data.format.keys().hasOnly(['normalizedArrays', 'backupVersion'])
          && request.resource.data.format.normalizedArrays is bool
          && request.resource.data.format.backupVersion is string
          && request.resource.data.format.backupVersion.size() <= 50);
    }

    function validEnvelope() {
      return request.resource.data.keys().hasOnly([
        'schemaVersion',
        'revision',
        'lastSavedAt',
        'client',
        'serverMetadata',
        'data',
        'sectionUpdatedAt',
        'entryUpdatedAt',
        'migration',
        'format'
      ])
      && request.resource.data.schemaVersion in ['fireOS_v2', 'fireOS_v3', 'fireOS_v4', 'fireOS_v5']
      && (!('revision' in request.resource.data)
        || (request.resource.data.revision is int
          && request.resource.data.revision >= 0
          && request.resource.data.revision <= 1000000000))
      && isIso(request.resource.data.lastSavedAt)
      && validPersistedData()
      && validClient()
      && validSectionClocks()
      && validServerMetadata()
      && validEntryUpdatedAt()
      && validMigration()
      && validFormat();
    }

    match /users/{uid}/portfolio/state {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validEnvelope();
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/portfolio/state/holdings/{holdingId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && holdingId.size() <= 128 && validMfHoldingDocument();
      allow delete: if isOwner(uid);
    }
  }
}
